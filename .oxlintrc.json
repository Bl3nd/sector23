{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "style": "warn"
  },
  "rules": {
    "eqeqeq": "warn",
    "eslint/no-unused-vars": "warn",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["*.tsx", "*.ts"],
      "rules": {
        "sortImports": "off",
      }
    }
  ],
  "env": {
    "builtin": true
  }
}