{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "style": "warn"
  },
  "rules": {
    "eqeqeq": "warn",
    "eslint/no-unused-vars": "warn",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["*.tsx", "*.ts"],
      "rules": {
        "eslint/sort-imports": "off",
        "new-cap": "off",
        "eslint/one-var": "off",
        "func-style": "off",
        "no-ternary": "allow",
        "no-duplicate-imports": "allow"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
